# ------------------------------------------------------------------
# lab2_murphy.pdc
# Author: Haspard Murphy <hmurphy@g.hmc.edu>
# Date:   2026-09-12
# Course: HMC E155, Lab 2
# Board:  E155 FA23 Development Board (UPduino v3.1 / iCE40 UP5K)
# ------------------------------------------------------------------

# ---- Reset (SW0 push button, active-low, needs internal pull-up) ----
ldc_set_location -site {34} [get_ports {reset}]
ldc_set_port -iobuf {PULLMODE=100K} [get_ports {reset}]

# ---- s0 (SW6 4-DIP, active-low, needs internal pull-ups) ----
ldc_set_location -site {37} [get_ports {s0[0]}]
ldc_set_location -site {31} [get_ports {s0[1]}]
ldc_set_location -site {35} [get_ports {s0[2]}]
ldc_set_location -site {32} [get_ports {s0[3]}]
ldc_set_port -iobuf {PULLMODE=100K} [get_ports {s0[0]}]
ldc_set_port -iobuf {PULLMODE=100K} [get_ports {s0[1]}]
ldc_set_port -iobuf {PULLMODE=100K} [get_ports {s0[2]}]
ldc_set_port -iobuf {PULLMODE=100K} [get_ports {s0[3]}]

# ---- s1 (SW7 positions 1-4, MCU-bridged to ground, active-low) ----
# Requires MCU firmware to drive PA5, PA6, PA9, PA10 LOW.
# SW7 positions 1-4 must be CLOSED to bridge MCU-low to FPGA input.
ldc_set_location -site {27} [get_ports {s1[0]}]
ldc_set_location -site {26} [get_ports {s1[1]}]
ldc_set_location -site {25} [get_ports {s1[2]}]
ldc_set_location -site {23} [get_ports {s1[3]}]
ldc_set_port -iobuf {PULLMODE=100K} [get_ports {s1[0]}]
ldc_set_port -iobuf {PULLMODE=100K} [get_ports {s1[1]}]
ldc_set_port -iobuf {PULLMODE=100K} [get_ports {s1[2]}]
ldc_set_port -iobuf {PULLMODE=100K} [get_ports {s1[3]}]

# ---- Seven-segment shared segment lines (active-low, from Lab 1) ----
ldc_set_location -site {46} [get_ports {seg[0]}]
ldc_set_location -site {45} [get_ports {seg[1]}]
ldc_set_location -site {48} [get_ports {seg[2]}]
ldc_set_location -site {47} [get_ports {seg[3]}]
ldc_set_location -site {2}  [get_ports {seg[4]}]
ldc_set_location -site {18} [get_ports {seg[5]}]
ldc_set_location -site {13} [get_ports {seg[6]}]

# ---- Display anode drivers (to 2N3906 PNP bases) ----
# P10 and P20 sit on SW7 pos 6 and 5 respectively; those switches
# must be physically OPEN so the FPGA output isn't tied to MCU pins.
ldc_set_location -site {10} [get_ports {anode_0}]
ldc_set_location -site {20} [get_ports {anode_1}]

# ---- Keypad row drivers (to 2N3904 NPN bases) ----
# P12 sits on SW7 pos 7; keep that switch OPEN or ensure MCU PB4 is Hi-Z.
ldc_set_location -site {12} [get_ports {rows[0]}]
ldc_set_location -site {9}  [get_ports {rows[1]}]
ldc_set_location -site {44} [get_ports {rows[2]}]
ldc_set_location -site {3}  [get_ports {rows[3]}]

# ---- Keypad column reads (external pull-ups on breadboard; NO internal) ----
ldc_set_location -site {19} [get_ports {cols[0]}]
ldc_set_location -site {11} [get_ports {cols[1]}]
ldc_set_location -site {6}  [get_ports {cols[2]}]
ldc_set_location -site {4}  [get_ports {cols[3]}]
ldc_set_port -iobuf {PULLMODE=NONE} [get_ports {cols[0]}]
ldc_set_port -iobuf {PULLMODE=NONE} [get_ports {cols[1]}]
ldc_set_port -iobuf {PULLMODE=NONE} [get_ports {cols[2]}]
ldc_set_port -iobuf {PULLMODE=NONE} [get_ports {cols[3]}]

# ---- Column-echo LEDs ----
# col_leds[0..2] drive onboard LEDs D6, D7, D8.
# col_leds[3] drives an external LED on P21 (SW7 pos 8 must be OPEN).
ldc_set_location -site {28} [get_ports {col_leds[0]}]
ldc_set_location -site {38} [get_ports {col_leds[1]}]
ldc_set_location -site {42} [get_ports {col_leds[2]}]
ldc_set_location -site {21} [get_ports {col_leds[3]}]
